# Copy these into Vercel: Project -> Settings -> Environment Variables
# For local development, put the real values in a file named ".env" (git-ignored).

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/test

# Gmail SMTP account used by Flask-Mail
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password

# Signs session cookies / flash messages. Must be STABLE across cold starts,
# otherwise every serverless invocation invalidates sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Telegram bot used as the image store
# 1. Create a bot with @BotFather -> gives you the token
# 2. Send it a message, then get the chat id from
#    https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Guards the editing routes behind the sign-in page at /login. Without these
# every admin route returns 503 rather than running unauthenticated.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional but strongly recommended. The public address of the site, used for
# canonical links, Open Graph tags and sitemap.xml.
#
# Canonical URLs stay pointed at this domain even when you are testing locally
# or on a preview deployment, which is what you want - those URLs should not
# compete with the real one in search results.
SITE_URL=https://blog.rohadas.in

# Optional. Your X/Twitter handle without the @, used for twitter:creator.
TWITTER_HANDLE=rohada_chirag
